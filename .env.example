# SENTIVRA — environment configuration template
# Copy to .env and fill in real values. Never commit .env.

# ---- Core ----
SENTIVRA_ENV=development
SENTIVRA_SECRET_KEY=changeme-generate-a-real-secret
# SENTIVRA_DATABASE_URL=sqlite:///C:/path/to/sentivra.db   # default: sentivra.db at the repo root
SENTIVRA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SENTIVRA_LOG_LEVEL=INFO

# ---- Rate limiting ----
SENTIVRA_RATE_LIMIT_PER_MINUTE=300   # per client IP; the dashboard needs several requests per page

# ---- Security engines (auto-detected at startup; set only to override paths) ----
SENTIVRA_YARA_RULES_DIR=detection-rules/yara   # relative paths resolve against the repo root
SENTIVRA_CLAMD_SOCKET=
SENTIVRA_SURICATA_EVE_LOG=
SENTIVRA_ZEEK_LOG_DIR=

# ---- Gmail integration (OAuth2, least-privilege: gmail.readonly only) ----
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_VERIFICATION_TOKEN=

# ---- Telegram integration (official Bot API) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET_TOKEN=

# ---- WhatsApp Business Cloud API (official, direct to Meta Graph API) ----
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
