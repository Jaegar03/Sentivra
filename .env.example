# SENTIVRA — environment configuration template
# Copy to .env and fill in real values. Never commit .env.

# ---- Core ----
SENTIVRA_ENV=development
# JWT signing secret. Leave EMPTY in development: a random per-install key is
# generated in .sentivra/signing.key. Required outside development, at least
# 32 random characters. Placeholders and short values are refused. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SENTIVRA_SECRET_KEY=
# SENTIVRA_DATABASE_URL=sqlite:///C:/path/to/sentivra.db   # default: sentivra.db at the repo root
SENTIVRA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SENTIVRA_LOG_LEVEL=INFO

# ---- API authentication (OAuth2 client credentials) ----
# Leave empty in development: on first start the backend creates a "dashboard"
# client, prints its secret once, and stores only the hash in .sentivra/.
# Outside development, list each client as  id:secret:scope scope  separated
# by ";" (or a JSON list). Secrets need at least 32 characters.
# Scopes: read, analyze, ingest, alerts:write.
#   SENTIVRA_OAUTH_CLIENTS=dashboard:<secret>:read analyze alerts:write;osquery-agent:<secret>:ingest
SENTIVRA_OAUTH_CLIENTS=
SENTIVRA_TOKEN_TTL_S=3600
SENTIVRA_STATE_DIR=.sentivra   # generated signing key + client-secret hashes; gitignored

# ---- Rate limiting and request size ----
SENTIVRA_RATE_LIMIT_PER_MINUTE=300        # per client IP; the dashboard needs several requests per page
SENTIVRA_TOKEN_RATE_LIMIT_PER_MINUTE=10   # per client IP, token endpoint only (where secrets can be guessed)
SENTIVRA_MAX_UPLOAD_BYTES=52428800        # file / PCAP / osquery / log uploads (50 MB)
SENTIVRA_MAX_JSON_BYTES=1048576           # every other request body (1 MB)

# ---- Security engines (auto-detected at startup; set only to override paths) ----
SENTIVRA_YARA_RULES_DIR=detection-rules/yara   # relative paths resolve against the repo root
SENTIVRA_CLAMD_SOCKET=
SENTIVRA_SURICATA_EVE_LOG=
SENTIVRA_ZEEK_LOG_DIR=

# ---- Messaging connectors (Phase 7 webhooks) ----
# Each connector fails closed: set only what you are actually connecting, and
# GET /api/v1/integrations reports "Not configured" naming the missing
# variables. Setup steps: docs/api.md # Webhooks. Data handling: docs/privacy.md.

# ---- Gmail integration (OAuth2, least-privilege: gmail.readonly only) ----
# The push arrives as a Cloud Pub/Sub notification; the refresh token is what
# lets the connector read the mailbox it watched, always with gmail.readonly.
SENTIVRA_GMAIL_OAUTH_CLIENT_ID=
SENTIVRA_GMAIL_OAUTH_CLIENT_SECRET=
SENTIVRA_GMAIL_OAUTH_REFRESH_TOKEN=
SENTIVRA_GMAIL_PUBSUB_TOPIC=
# Optional shared token, accepted as ?verify_token= or X-Goog-Verification-Token
# on a manual push (curl) before a Pub/Sub subscription exists.
SENTIVRA_GMAIL_PUBSUB_VERIFICATION_TOKEN=

# ---- Telegram integration (official Bot API) ----
# The secret is given to setWebhook as secret_token and echoed back by Telegram
# in X-Telegram-Bot-Api-Secret-Token on every delivery.
SENTIVRA_TELEGRAM_BOT_TOKEN=
SENTIVRA_TELEGRAM_WEBHOOK_SECRET_TOKEN=

# ---- WhatsApp Business Cloud API (official, direct to Meta Graph API) ----
# The App Secret signs every webhook (X-Hub-Signature-256); the verify token is
# what the App Dashboard must send for Meta's GET handshake to succeed.
SENTIVRA_WHATSAPP_APP_SECRET=
SENTIVRA_WHATSAPP_ACCESS_TOKEN=
SENTIVRA_WHATSAPP_PHONE_NUMBER_ID=
SENTIVRA_WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ---- Frontend ----
# The dashboard doesn't read this file. Next.js only loads env files from
# frontend/, so put this in frontend/.env.local, then rebuild (it's baked
# into the build, including the dashboard's Content-Security-Policy):
#   NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
